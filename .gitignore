# スクリプトデータ（JSON）は共有リポジトリに含めない
*.json

# 環境ごとの設定（.env.example のみコミットする）
.env

# スクリーンショットは Release アセットとしてホスト（リポジトリ本体には置かない）
screenshot_*.png

# アイコン実体は配布先の repo/icons に一本化。
# git ではツール自身のシェルフアイコンのみ管理する。
repo/icons/*.png
!repo/icons/mayascriptsmanager.png
repo/icons/*.psb

# OMC / エージェントの内部状態
.omc/

# OS / エディタ
Thumbs.db
*.tmp
__pycache__/
*.pyc
